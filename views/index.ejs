<%- include('partials/header', { title: 'Home' }) %>


<section class="section-jumbotron">
  <div id="sblCarousel" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-indicators">
      <button type="button" data-bs-target="#sblCarousel" data-bs-slide-to="0" class="active"></button>
      <button type="button" data-bs-target="#sblCarousel" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#sblCarousel" data-bs-slide-to="2"></button>
      <button type="button" data-bs-target="#sblCarousel" data-bs-slide-to="3"></button>
      <button type="button" data-bs-target="#sblCarousel" data-bs-slide-to="4"></button>
    </div>
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/img/slide-1.jpg" class="carousel-img" alt="Slide 1" />
        <div class="carousel-caption-sbl">
          <h2>The Game Begins</h2>
          <p>The court is where every basketball journey begins. Players compete, work together, and show their skill throughout the league.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="/img/slide-2.jpg" class="carousel-img" alt="Slide 2" />
        <div class="carousel-caption-sbl">
          <h2>Power at the Rim</h2>
          <p>Dunks are one of the most exciting moments in basketball. They show athleticism, confidence, and the energy of the game.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="/img/slide-3.jpg" class="carousel-img" alt="Slide 3" />
        <div class="carousel-caption-sbl">
          <h2>Fans Make It Special</h2>
          <p>Basketball is not only about the players. Fans bring energy to the court and make every league game more exciting.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="/img/slide-4.jpg" class="carousel-img" alt="Slide 4" />
        <div class="carousel-caption-sbl">
          <h2>The Championship Moment</h2>
          <p>Winning the Championship is the reward for teamwork, effort, and determination throughout the season.</p>
        </div>
      </div>
      <div class="carousel-item">
        <img src="/img/slide-5.jpg" class="carousel-img" alt="Slide 5" />
        <div class="carousel-caption-sbl">
          <h2>Champions of the Game</h2>
          <p>A Championship represents more than a trophy. It represents the hard work, teamwork, and memories created during the league.</p>
        </div>
      </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#sblCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#sblCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>
  </div>
</section>


<section class="section-pad">
  <div class="container">
    <div class="text-center">
      <h2 class="heading-underline">Latest SBL Updates</h2>
      <p class="section-subheading">Here are the latest updates related on SBL</p>
    </div>
    <div class="row g-4 mt-4">
      <% news.forEach(function(item) { %>
        <div class="col-12 col-sm-6 col-lg-3">
          <article class="card-news h-100">
            <img src="<%= item.image %>" class="card-img-top" alt="News" />
            <div class="p-3">
              <p class="news-date"><i class="fa-regular fa-calendar me-1"></i><%= item.date %></p>
              <h5 class="news-title"><%= item.title %></h5>
              <p class="news-desc"><%= item.description %></p>
            </div>
          </article>
        </div>
      <% }) %>
    </div>
  </div>
</section>


<section class="section-cta">
  <div class="container">
    <h3 class="cta-title">Get Your Tickets Now!</h3>
    <p class="cta-sub">Don't miss the excitement! Grab your tickets and experience the thrill of Surabaya basketball live on the court.</p>
    <a href="/tickets" class="btn btn-sbl">
      <i class="fa-solid fa-ticket me-2"></i>Get Tickets
    </a>
  </div>
</section>


<section class="section-pad">
  <div class="container">
    <div class="text-center">
      <h2 class="heading-underline">Top 5 SBL Teams</h2>
      <p class="section-subheading">Klasemen sementara tim terbaik musim ini</p>
    </div>
    <div class="row g-4 mt-4 justify-content-center">
      <% topTeams.forEach(function(team) { %>
        <div class="col-6 col-md-4 col-lg-2">
          <div class="card-team h-100 text-center p-3">
            <img src="<%= team.logo %>" class="team-logo" alt="<%= team.name %>" />
            <h6 class="team-name mb-1"><%= team.name %></h6>
            <p class="mb-0 fw-bold"><%= team.totalPoints %> pts</p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>


<section class="section-cta">
  <div class="container">
    <h3 class="cta-title">Meet Our Teams!</h3>
    <p class="cta-sub">Get to know the teams, discover your favorite players, and find out who will dominate the Surabaya Basketball League!</p>
    <a href="/teams" class="btn btn-sbl">
      <i class="fa-solid fa-users me-2"></i>View All Teams
    </a>
  </div>
</section>


<%- include('partials/footer') %>